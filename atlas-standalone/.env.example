# Copy to .env.local. Never commit actual keys or database passwords.
APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Server-only: Supabase secret key (or legacy service_role key).
SUPABASE_SECRET_KEY=YOUR_SERVER_SECRET_KEY
# Runtime: transaction pooler URI from Supabase Connect, port 6543.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_URL_ENCODED_PASSWORD@YOUR_POOLER_HOST:6543/postgres
# Local migrations only: direct or session pooler URI, port 5432.
DATABASE_MIGRATION_URL=postgresql://postgres.YOUR_PROJECT:YOUR_URL_ENCODED_PASSWORD@YOUR_POOLER_HOST:5432/postgres
